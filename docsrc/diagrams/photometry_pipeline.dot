// From a selected star to an exported row (docsrc/ARCHITECTURE.md, "Photometry").
// Live (argos/server/photometry.py) and the batch re-run (argos/server/rerun.py)
// call the same core functions; the method is docsrc/differential_photometry.md.
digraph photometry_pipeline {
  rankdir=TB;
  graph [fontname="IBM Plex Sans, Helvetica, Arial, sans-serif", fontsize=11, fontcolor="#1a2120",
         bgcolor="#f3f3ee", pad=0.3, nodesep=0.5, ranksep=0.3,
         size="7.9,40", stylesheet="../_static/diagrams.css"];
  node  [fontname="IBM Plex Sans, Helvetica, Arial, sans-serif", fontsize=10, fontcolor="#1a2120",
         shape=box, style="rounded,filled", fillcolor="#ffffff", color="#1a2120", penwidth=1];
  edge  [fontname="IBM Plex Mono, Menlo, Consolas, monospace", fontsize=8.5, fontcolor="#1a2120",
         color="#c49a3c", penwidth=2.2, arrowsize=0.7];

  raw   [label="Raw frame\nBayer mosaic, uint16", shape=box3d, style="filled", fillcolor="#e5e8e1"];
  set   [label="TargetSet\ntarget, comparisons, check\n(RA, Dec)", fillcolor="#e5e8e1"];
  green [label="green_plane()\n(G1 + G2) / 2\nimaging/green.py"];
  wcs   [label="TrackedWCS\nApertureTracker\nphotometry/tracking.py"];
  meas  [label="measure_frame()\naperture from the FWHM\nphotometry/params.py"];
  ap    [label="measure_aperture()\nper star, sky annulus\nphotometry/aperture.py"];
  diff  [label="differential_mag()\nensemble zero point\nphotometry/differential.py"];
  pt    [label="LcPoint\nmagnitude, error, flags,\ntimes, airmass"];
  floor [label="estimate_systematic_floor()\nrun level\nphotometry/uncertainty.py"];
  out   [label="CSV, AAVSO report\nwrite_curves_csv(), write_aavso()\nphotometry/lightcurve.py", shape=note, fillcolor="#e5e8e1"];

  raw   -> green;
  set   -> wcs  [label="world_to_pixel_deg()", color="#65706d", penwidth=1];
  green -> meas;
  wcs   -> meas [label="star positions\n(green px)", color="#65706d", penwidth=1];
  meas  -> ap;
  ap    -> diff;
  diff  -> pt;
  pt    -> floor;
  floor -> out;

  { rank=same; raw; set; }
  { rank=same; green; wcs; }
}
