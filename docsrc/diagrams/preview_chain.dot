// The live frame path of 0.5.0, camera to screen (docsrc/ARCHITECTURE.md, "Live view").
// Sources: argos/server/hub.py (exposure job), events.py (latest wins),
// frames.py (wire layout), protocol.md "WebSocket /ws/frames", web/README.md
// "Architecture" (decodeFrame, WebGL2).
digraph preview_chain {
  rankdir=TB;
  graph [fontname="IBM Plex Sans, Helvetica, Arial, sans-serif", fontsize=11, fontcolor="#1a2120",
         bgcolor="#f3f3ee", pad=0.3, nodesep=0.4, ranksep=0.35,
         size="7.9,40", stylesheet="../_static/diagrams.css"];
  node  [fontname="IBM Plex Sans, Helvetica, Arial, sans-serif", fontsize=10, fontcolor="#1a2120",
         shape=box, style="rounded,filled", fillcolor="#ffffff", color="#1a2120", penwidth=1];
  edge  [fontname="IBM Plex Mono, Menlo, Consolas, monospace", fontsize=8.5, fontcolor="#1a2120",
         color="#c49a3c", penwidth=2.2, arrowsize=0.7];

  cam [label="Camera\nAlpaca ImageBytes,\nor the simulator", shape=box3d, style="filled", fillcolor="#e5e8e1"];

  subgraph cluster_server {
    label="argos/server"; labeljust=l; style="rounded"; color="#b9c1ba"; margin=12;
    exp [label="Exposure job thread\nstart, poll ImageReady,\ndownload uint16"];
    pub [label="Hub publishes the frame\nheader, 65 536-bin histogram\n(exact median and MAD)"];
    q   [label="One pending frame\nper client: a slow\nclient skips frames"];
  }

  subgraph cluster_ui {
    label="Web UI"; labeljust=l; style="rounded"; color="#b9c1ba"; margin=12;
    dec [label="decodeFrame()\nUint16Array view on the\nmessage buffer, no copy"];
    gl  [label="WebGL2 texture (R16UI)\nstretch, rotation, zoom\nas shader uniforms"];
  }

  side [label="Also fed with each frame:\nfield tracking (frame thread,\nlatest wins), frame metrics,\nFITS save (Take shot, sequence)", shape=note, fillcolor="#e5e8e1"];

  cam -> exp;
  exp -> pub;
  pub -> q;
  q   -> dec [label="/ws/frames: JSON header,\nuint16 LE at an\n8-byte aligned offset"];
  dec -> gl;
  pub -> side [color="#65706d", penwidth=1, style=dashed];
}
