# Cargo output (builds normally set CARGO_TARGET_DIR outside the repo).
/target/
# Schemas regenerated by tauri-build on every build.
/gen/schemas
# The frozen ARGOS server (one-dir), built by packaging/argos_server.spec into
# binaries/argos-server/ (tauri.conf.json bundle.macOS.files, linux.deb.files).
/binaries/
